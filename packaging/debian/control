# Debian and Ubuntu already have a `glance`: OpenStack's Image Service. The
# source and binary package therefore have to be called something else.
Source: glance-image-viewer
Section: graphics
Priority: optional
Maintainer: Abhilesh Singh <sabhilesh260@gmail.com>
# libglib2.0-dev is for glib-compile-resources: build.rs uses it to compile the
# icons into the binary, so the program finds its own icon before installation.
